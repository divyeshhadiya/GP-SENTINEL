{
  "openapi": "3.0.3",
  "info": {
    "title": "GP-SENTINEL Unified REST API",
    "description": "Gujarat Police State Crime Record Bureau (SCRB) • Unified Statewide Video Intelligence & Multi-Department CCTV Federation API",
    "version": "2026.4.1-LTS",
    "contact": {
      "name": "Gujarat Police SCRB Video Intelligence Command",
      "url": "https://sentinel.gujarat.gov.in"
    }
  },
  "servers": [
    {
      "url": "https://gp-sentinel.vercel.app",
      "description": "Production Server (Vercel)"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/api/cameras": {
      "get": {
        "tags": ["GIS CCTV Registry"],
        "summary": "List all registered CCTV camera nodes",
        "description": "Retrieve statewide CCTV inventory across 26 government departments with PostGIS coordinates, RTSP stream URLs, VMS vendors, codecs, and AMC health status.",
        "parameters": [
          {
            "name": "department",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Filter by department (e.g. 'Gujarat Police', 'GSRTC', 'AMC')"
          },
          {
            "name": "district",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Filter by district (e.g. 'Gandhinagar', 'Ahmedabad', 'Surat')"
          },
          {
            "name": "status",
            "in": "query",
            "schema": { "type": "string", "enum": ["Online", "Degraded", "Offline"] },
            "description": "Filter by operational ping status"
          },
          {
            "name": "q",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Text search across camera ID, landmark, and junction"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of camera inventory",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": { "type": "integer" },
                    "cameras": { "type": "array", "items": { "$ref": "#/components/schemas/Camera" } }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["GIS CCTV Registry"],
        "summary": "Onboard a new CCTV node",
        "description": "Register a new departmental camera into the centralized state inventory.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CameraInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Camera node successfully registered"
          }
        }
      }
    },
    "/api/alerts": {
      "get": {
        "tags": ["Live Incidents & Dispatch"],
        "summary": "Fetch active incident alert queue",
        "description": "Streams real-time AI alert detections matched against VAHAN and e-GujCop watchlists.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": { "type": "string", "enum": ["NEW", "ACKNOWLEDGED", "DISPATCHED", "RESOLVED"] }
          },
          {
            "name": "priority",
            "in": "query",
            "schema": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Active alert records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": { "type": "integer" },
                    "alerts": { "type": "array", "items": { "$ref": "#/components/schemas/Alert" } }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Live Incidents & Dispatch"],
        "summary": "Update incident status / Dispatch PCR patrol",
        "description": "Acknowledge an alert or dispatch the nearest PCR patrol intercept van.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "alertId": { "type": "string" },
                  "status": { "type": "string", "enum": ["ACKNOWLEDGED", "DISPATCHED", "RESOLVED", "FALSE_POSITIVE"] },
                  "dispatchedUnit": { "type": "object" }
                },
                "required": ["alertId", "status"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Alert status updated successfully" }
        }
      }
    },
    "/api/vehicle/track": {
      "post": {
        "tags": ["Vehicle Traversal Tracking"],
        "summary": "Reconstruct vehicle route & traversal trajectory",
        "description": "Queries ANPR camera grid to reconstruct multi-hop corridor movement for a target license plate.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "plate": { "type": "string", "example": "GJ-01-AB-1234" }
                },
                "required": ["plate"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chronological checkpoints with timestamps, speeds, and Section 65B forensic hash",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "plate": { "type": "string" },
                    "totalSightings": { "type": "integer" },
                    "sightings": { "type": "array", "items": { "$ref": "#/components/schemas/VehicleSighting" } },
                    "watchlistMatch": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/watchlists": {
      "get": {
        "tags": ["Watchlists & Intelligence"],
        "summary": "List cross-agency watchlists",
        "description": "Returns VAHAN stolen vehicle registry and e-GujCop criminal blacklist records.",
        "responses": {
          "200": {
            "description": "Watchlist database records"
          }
        }
      },
      "post": {
        "tags": ["Watchlists & Intelligence"],
        "summary": "Add vehicle to active watchlist",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/WatchlistInput" }
            }
          }
        },
        "responses": {
          "201": { "description": "Watchlist entry created" }
        }
      }
    },
    "/api/gap-analysis": {
      "get": {
        "tags": ["Analytics & Gap Reports"],
        "summary": "Statewide surveillance blindspot gap analysis",
        "description": "Returns 33-district CCTV density, coverage ratios, and high-priority blindspot recommendations.",
        "responses": {
          "200": { "description": "District coverage and gap analysis dataset" }
        }
      }
    },
    "/api/ingest": {
      "get": {
        "tags": ["Video Streaming Sandbox"],
        "summary": "Live video streaming ingestion catalog",
        "description": "Returns RTSP, HLS, and WebRTC streaming endpoints for developer sandbox integration.",
        "responses": {
          "200": { "description": "Active RTSP/HLS stream URLs" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Officer portal authentication",
        "description": "Authenticates police credentials and issues signed session JWT tokens.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "example": "dgp.police@gujarat.gov.in" },
                  "password": { "type": "string", "example": "GujaratPolice@2026" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Authenticated officer profile & JWT token" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Camera": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "CAM-GNR-001" },
          "name": { "type": "string", "example": "Gandhinagar Police HQ Gate 1" },
          "department": { "type": "string", "example": "Gujarat Police" },
          "district": { "type": "string", "example": "Gandhinagar" },
          "locationName": { "type": "string", "example": "Sector 10 Circle, Gandhinagar" },
          "coordinates": { "type": "array", "items": { "type": "number" }, "example": [23.223, 72.649] },
          "status": { "type": "string", "enum": ["Online", "Degraded", "Offline"] },
          "cameraType": { "type": "string", "example": "ANPR" },
          "vendor": { "type": "string", "example": "Hikvision ANPR Pro" },
          "vmsVendor": { "type": "string", "example": "Hikvision" },
          "resolution": { "type": "string", "example": "1080p (FHD)" },
          "fps": { "type": "integer", "example": 30 },
          "codec": { "type": "string", "example": "H.265" },
          "storageDays": { "type": "integer", "example": 30 },
          "storageType": { "type": "string", "example": "Hybrid SAN" },
          "rtspUrl": { "type": "string", "example": "rtsp://sandbox.sentinel.gujarat.gov.in:8554/cam-gnr-001" },
          "hlsUrl": { "type": "string", "example": "https://streams.sentinel.gujarat.gov.in/hls/cam-gnr-001/index.m3u8" },
          "ipAddress": { "type": "string", "example": "10.18.4.12" },
          "amcActive": { "type": "boolean", "example": true },
          "pingMs": { "type": "integer", "example": 14 }
        }
      },
      "CameraInput": {
        "type": "object",
        "required": ["name", "department", "district", "locationName", "coordinates"],
        "properties": {
          "name": { "type": "string" },
          "department": { "type": "string" },
          "district": { "type": "string" },
          "locationName": { "type": "string" },
          "coordinates": { "type": "array", "items": { "type": "number" } },
          "cameraType": { "type": "string" },
          "rtspUrl": { "type": "string" },
          "storageDays": { "type": "integer" }
        }
      },
      "Alert": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "ALT-2026-0891" },
          "timestamp": { "type": "string", "format": "date-time" },
          "cameraId": { "type": "string" },
          "cameraName": { "type": "string" },
          "registrationNumber": { "type": "string", "example": "GJ-01-AB-1234" },
          "locationName": { "type": "string" },
          "coordinates": { "type": "array", "items": { "type": "number" } },
          "status": { "type": "string", "enum": ["NEW", "ACKNOWLEDGED", "DISPATCHED", "RESOLVED"] },
          "dispatchedUnit": { "type": "object" }
        }
      },
      "VehicleSighting": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "cameraId": { "type": "string" },
          "cameraName": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" },
          "locationName": { "type": "string" },
          "district": { "type": "string" },
          "coordinates": { "type": "array", "items": { "type": "number" } },
          "speedKmh": { "type": "integer" },
          "confidence": { "type": "number", "example": 0.984 },
          "heading": { "type": "string", "example": "South-West towards Surat" },
          "ptsMs": { "type": "integer" },
          "sha256Hash": { "type": "string" }
        }
      },
      "WatchlistInput": {
        "type": "object",
        "required": ["identifier", "category", "source"],
        "properties": {
          "identifier": { "type": "string", "example": "GJ-01-AB-1234" },
          "category": { "type": "string", "example": "Stolen Vehicle" },
          "source": { "type": "string", "example": "VAHAN" },
          "details": { "type": "string" },
          "firNumber": { "type": "string" },
          "policeStation": { "type": "string" }
        }
      }
    }
  }
}